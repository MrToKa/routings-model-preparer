{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wfc:portable-model-manifest:v1",
  "title": "Portable model manifest v1",
  "type": "object",
  "additionalProperties": false,
  "$comment": "Runtime validators additionally reject duplicate JSON keys (including escaped keys), Unicode controls/lone surrogates, unsafe/reserved path segments, case collisions, unsorted resources, invalid UTC calendar dates, absent entrypoint, actual stream limits, hash/fingerprint mismatches and unsupported SVF structures. JSON Schema alone cannot prove raw resource integrity or reference closure. SDK/runtime is delivered separately.",
  "required": [
    "schemaVersion",
    "packageId",
    "label",
    "source",
    "preparedAt",
    "supportProfile",
    "format",
    "sdkVersion",
    "entrypoint",
    "resources",
    "contentFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "preparedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "supportProfile": {
      "const": "svf-local-7.130.0-v1"
    },
    "format": {
      "const": "svf"
    },
    "sdkVersion": {
      "const": "7.130.0"
    },
    "entrypoint": {
      "const": "resources/output/0/0.svf"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/resource"
      },
      "uniqueItems": true
    },
    "contentFingerprint": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "sha256",
        "identityBasis"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "identityBasis": {
          "enum": [
            "observed-local-file",
            "captured-at-conversion"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 11,
          "maxLength": 1024,
          "pattern": "^resources/[A-Za-z0-9._/-]+(?:\\.svf|\\.pf|\\.bin|\\.pack|\\.json\\.gz|\\.db|\\.[pP][nN][gG]|\\.[jJ][pP][eE]?[gG])$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
